# A ready summary pays at the idle return with its call priced at zero; every fresh call misses the law.
# Omitting ready keys from the native planner sends it request-locally instead of through the open idle door.
world explicit known ttl=300 true=300 survival=none c=1 sys=3000 window=200000 native interactive long
prompt +0s
say 60K
prompt +60s
say 100
prompt +1h
say 100
