# Five prose turns need a summary at the first paying pause, but not while warm.
# A usage touch shortly before the old 301-second deadline postpones that call.
world explicit known ttl=300 true=300 survival=none c=1 sys=3000 window=200000 native interactive
prompt
say 30K
prompt +1s
say 30K
prompt +1s
say 30K
prompt +1s
say 30K
prompt +1s
say 30K
wait +290s
aside
wait +20s
prompt +0s
say 100
wait +310s
prompt +0s
say 100
