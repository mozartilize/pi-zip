# A cold return carries folds; its turn_end remains at the room and waits for its own paying cut.
world explicit known ttl=300 true=300 survival=none c=1 sys=3000 window=128000 nonative print
prompt
call npm 1K
say 90K
prompt +60s
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
call npm 100
say 20K
prompt +1h
call npm 40K
say 100
